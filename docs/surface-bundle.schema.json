            "f64",
            "i32",
            "u8",
            "u16",
            "u32",
            "u64"
          ]
        },
        "components": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "set_index": {
          "anyOf": [
