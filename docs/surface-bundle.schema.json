        },
        "attribute_offsets": {
          "$ref": "#/$defs/u64"
        },
        "presence_bytes": {
          "$ref": "#/$defs/u64"
        },
        "metadata_entries": {
          "$ref": "#/$defs/u64"
        },
        "descriptor_bytes": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "vertices",
        "faces",
        "corners",
        "face_offsets",
        "attributes",
        "attribute_scalars",
        "attribute_bytes",
        "attribute_offsets",
        "presence_bytes",
        "metadata_entries",
        "descriptor_bytes"
      ],
      "additionalProperties": false
