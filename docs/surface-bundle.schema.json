{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meshvale:surface-bundle:1",
  "title": "Meshvale surface bundle version 1",
  "description": "JSON shape only. Exact uint64, binary, range, mapping, native-format, numeric and member-hash validation in surface-output.md is also mandatory.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "meshvale.surface-bundle/1"
    },
    "encoding": {
      "enum": [
        "gltf-json",
        "glb",
        "stl-ascii",
        "stl-binary"
      ]
    },
    "representation": {
      "const": "annotated-bundle-v1"
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "declared-meters-rh-y-up",
            "stl-untransformed"
          ]
        },
        "declared_unit_hex": {
          "$ref": "#/$defs/hex"
        }
      },
      "required": [
        "kind",
        "declared_unit_hex"
      ],
      "additionalProperties": false
    },
    "acknowledgments": {
      "type": "object",
      "properties": {
        "triangle_conversion": {
          "const": true
        },
        "corner_expansion": {
          "const": true
        },
        "unused_vertices": {
          "type": "boolean"
        }
      },
      "required": [
        "triangle_conversion",
        "corner_expansion",
        "unused_vertices"
      ],
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "minItems": 2
    },
    "original": {
      "$ref": "#/$defs/mesh"
    },
    "triangulated": {
      "$ref": "#/$defs/mesh"
    },
    "triangulation": {
      "type": "object",
      "properties": {
        "face_sources": {
          "$ref": "#/$defs/u64_slice"
        },
        "corner_sources": {
          "$ref": "#/$defs/u64_slice"
        },
        "face_output_offsets": {
          "$ref": "#/$defs/u64_slice"
        }
      },
      "required": [
        "face_sources",
        "corner_sources",
        "face_output_offsets"
      ],
      "additionalProperties": false
    },
    "wire": {
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/wire_counts"
        },
        "primitives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/primitive"
          }
        },
        "maps": {
          "type": "object",
          "properties": {
            "triangle_sources": {
              "$ref": "#/$defs/u64_slice"
            },
            "triangle_faces": {
              "$ref": "#/$defs/u64_slice"
            },
            "corner_sources": {
              "$ref": "#/$defs/u64_slice"
            },
            "corner_corners": {
              "$ref": "#/$defs/u64_slice"
            },
            "vertex_sources": {
              "$ref": "#/$defs/u64_slice"
            },
            "source_vertex_offsets": {
              "$ref": "#/$defs/u64_slice"
            },
            "source_vertex_members": {
              "$ref": "#/$defs/u64_slice"
            },
            "source_face_offsets": {
              "$ref": "#/$defs/u64_slice"
            },
            "source_face_members": {
              "$ref": "#/$defs/u64_slice"
            },
            "source_corner_offsets": {
              "$ref": "#/$defs/u64_slice"
            },
            "source_corner_members": {
              "$ref": "#/$defs/u64_slice"
            }
          },
          "required": [
            "triangle_sources",
            "triangle_faces",
            "corner_sources",
            "corner_corners",
            "vertex_sources",
            "source_vertex_offsets",
            "source_vertex_members",
            "source_face_offsets",
            "source_face_members",
            "source_corner_offsets",
            "source_corner_members"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "counts",
        "primitives",
        "maps"
      ],
      "additionalProperties": false
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "uv_mapping": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uv"
      }
    },
    "inverse_uv_mapping": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inverse_uv"
      }
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "numeric": {
      "type": "object",
      "properties": {
        "positions": {
          "$ref": "#/$defs/field_numeric"
        },
        "uv": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_attribute": {
                "$ref": "#/$defs/u64"
              },
              "source_set": {
                "$ref": "#/$defs/u32"
              },
              "wire_set": {
                "$ref": "#/$defs/u32"
              },
              "field": {
                "$ref": "#/$defs/field_numeric"
              }
            },
            "required": [
              "source_attribute",
              "source_set",
              "wire_set",
              "field"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "positions",
        "uv"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "encoding",
    "representation",
    "coordinates",
    "acknowledgments",
    "members",
    "original",
    "triangulated",
    "triangulation",
    "wire",
    "channels",
    "uv_mapping",
    "inverse_uv_mapping",
    "catalog",
    "numeric"
