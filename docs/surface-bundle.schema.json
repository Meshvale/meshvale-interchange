        "materials": {
          "$ref": "#/$defs/u64"
        },
        "textures": {
          "$ref": "#/$defs/u64"
        },
        "images": {
          "$ref": "#/$defs/u64"
        },
        "samplers": {
          "$ref": "#/$defs/u64"
        },
        "listed_members": {
          "$ref": "#/$defs/u64"
        },
        "listed_member_bytes": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "primitives",
        "vertices",
        "triangles",
        "corners",
        "map_entries",
        "materials",
        "textures",
        "images",
        "samplers",
        "listed_members",
