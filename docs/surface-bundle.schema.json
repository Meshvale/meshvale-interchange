        "path": {
          "type": "string",
          "pattern": "^(surface\\.(gltf|glb|stl|bin)|geometry\\.bin|images/image-(0|[1-9][0-9]*)\\.(png|jpg))$"
        },
        "role": {
          "enum": [
            "gltf",
            "glb",
            "stl",
            "geometry-buffer",
            "image",
            "capsule-binary"
