      "properties": {
        "key_hex": {
          "$ref": "#/$defs/hex"
        },
        "value_hex": {
          "$ref": "#/$defs/hex"
        }
      },
      "required": [
        "key_hex",
        "value_hex"
      ],
      "additionalProperties": false
    },
    "mesh_counts": {
      "type": "object",
      "properties": {
        "vertices": {
          "$ref": "#/$defs/u64"
        },
        "faces": {
          "$ref": "#/$defs/u64"
        },
        "corners": {
          "$ref": "#/$defs/u64"
        },
        "face_offsets": {
          "$ref": "#/$defs/u64"
        },
        "attributes": {
          "$ref": "#/$defs/u64"
        },
        "attribute_scalars": {
