  "additionalProperties": false,
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Semantic check additionally requires <= 2^64-1."
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slice": {
      "type": "object",
      "properties": {
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "count": {
          "$ref": "#/$defs/u64"
        },
        "bytes": {
          "$ref": "#/$defs/u64"
        },
        "scalar": {
          "enum": [
            "f32",
            "f64",
            "i32",
            "u8",
            "u16",
            "u32",
            "u64"
          ]
        }
      },
      "required": [
        "offset",
        "count",
        "bytes",
        "scalar"
      ],
      "additionalProperties": false
    },
    "u64_slice": {
      "type": "object",
      "properties": {
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "count": {
          "$ref": "#/$defs/u64"
        },
        "bytes": {
          "$ref": "#/$defs/u64"
        },
        "scalar": {
          "enum": [
            "u64"
          ]
        }
      },
      "required": [
        "offset",
        "count",
        "bytes",
        "scalar"
      ],
      "additionalProperties": false
    },
    "u8_slice": {
      "type": "object",
      "properties": {
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "count": {
          "$ref": "#/$defs/u64"
        },
        "bytes": {
          "$ref": "#/$defs/u64"
        },
        "scalar": {
          "enum": [
            "u8"
          ]
        }
      },
      "required": [
        "offset",
        "count",
        "bytes",
        "scalar"
      ],
      "additionalProperties": false
    },
    "f64_slice": {
      "type": "object",
      "properties": {
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "count": {
