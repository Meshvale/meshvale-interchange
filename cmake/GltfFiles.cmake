option(MESHVALE_INTERCHANGE_GLTF_FILES
  "Build retained native glTF/GLB file capture" OFF)
if(NOT MESHVALE_INTERCHANGE_GLTF_FILES)
  return()
endif()
if(NOT TARGET meshvale::gltf_workflow_support)
  message(FATAL_ERROR "glTF files require MESHVALE_INTERCHANGE_GLTF_WORKFLOW_SUPPORT=ON")
endif()

add_library(meshvale_interchange_gltf_files STATIC
  src/gltf_files.cpp src/gltf_file_paths.cpp src/gltf_file_native.cpp
  src/gltf_file_publish.cpp src/gltf_file_publish_native.cpp)
add_library(meshvale::gltf_files ALIAS meshvale_interchange_gltf_files)
set_target_properties(meshvale_interchange_gltf_files PROPERTIES
  EXPORT_NAME gltf_files POSITION_INDEPENDENT_CODE ON)
target_compile_features(meshvale_interchange_gltf_files PUBLIC cxx_std_20)
target_link_libraries(meshvale_interchange_gltf_files PUBLIC
  meshvale::gltf_workflow_support PRIVATE Threads::Threads)
meshvale_warnings(meshvale_interchange_gltf_files)
install(TARGETS meshvale_interchange_gltf_files EXPORT MeshvaleInterchangeTargets
  ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
install(FILES include/meshvale/interchange/gltf_files.h
  DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/meshvale/interchange")

function(meshvale_add_gltf_file_tests)
  target_sources(meshvale_interchange_header_checks PRIVATE tests/headers/gltf_files_h.cpp)
  target_link_libraries(meshvale_interchange_header_checks PRIVATE meshvale::gltf_files)
  add_executable(meshvale_gltf_files_link examples/consumer/gltf_files_link.cpp)
  target_link_libraries(meshvale_gltf_files_link PRIVATE meshvale::gltf_files)
  meshvale_warnings(meshvale_gltf_files_link)
  add_test(NAME gltf_files_link COMMAND meshvale_gltf_files_link)
  add_executable(meshvale_gltf_files_tests tests/gltf_files.cpp)
  target_include_directories(meshvale_gltf_files_tests PRIVATE src)
  target_link_libraries(meshvale_gltf_files_tests PRIVATE meshvale::gltf_files)
  meshvale_warnings(meshvale_gltf_files_tests)
  add_test(NAME gltf_files COMMAND meshvale_gltf_files_tests)
  foreach(fixture gltf_files_glb gltf_files_glb_requests)
    add_executable(meshvale_${fixture}_tests tests/${fixture}.cpp)
    target_include_directories(meshvale_${fixture}_tests PRIVATE src)
    target_link_libraries(meshvale_${fixture}_tests PRIVATE meshvale::gltf_files)
    meshvale_warnings(meshvale_${fixture}_tests)
    add_test(NAME ${fixture} COMMAND meshvale_${fixture}_tests)
  endforeach()
  add_executable(meshvale_gltf_file_publish_tests tests/gltf_file_publish.cpp)
  target_include_directories(meshvale_gltf_file_publish_tests PRIVATE src)
  target_link_libraries(meshvale_gltf_file_publish_tests PRIVATE meshvale::gltf_files)
  meshvale_warnings(meshvale_gltf_file_publish_tests)
  add_executable(meshvale_gltf_file_verified_provider_tests tests/gltf_file_verified_provider.cpp)
  target_include_directories(meshvale_gltf_file_verified_provider_tests PRIVATE src)
  target_link_libraries(meshvale_gltf_file_verified_provider_tests PRIVATE meshvale::gltf_files)
  meshvale_warnings(meshvale_gltf_file_verified_provider_tests)
  if(MESHVALE_INTERCHANGE_MATERIALIZATION_TEST_PROFILE STREQUAL "${_MESHVALE_INTERCHANGE_PROFILE_QUALIFIED}")
    add_test(NAME gltf_file_publish_semantics COMMAND meshvale_gltf_file_publish_tests)
    add_executable(meshvale_gltf_file_publish_requests_tests tests/gltf_file_publish_requests.cpp)
    target_include_directories(meshvale_gltf_file_publish_requests_tests PRIVATE src)
    target_link_libraries(meshvale_gltf_file_publish_requests_tests PRIVATE meshvale::gltf_files)
    meshvale_warnings(meshvale_gltf_file_publish_requests_tests)
    add_test(NAME gltf_file_publish_requests COMMAND meshvale_gltf_file_publish_requests_tests)
    add_test(NAME gltf_file_verified_provider_semantics COMMAND meshvale_gltf_file_verified_provider_tests)
    add_executable(meshvale_gltf_file_verified_provider_requests_tests tests/gltf_file_verified_provider_requests.cpp)
    target_include_directories(meshvale_gltf_file_verified_provider_requests_tests PRIVATE src)
    target_link_libraries(meshvale_gltf_file_verified_provider_requests_tests PRIVATE meshvale::gltf_files)
    meshvale_warnings(meshvale_gltf_file_verified_provider_requests_tests)
    add_test(NAME gltf_file_verified_provider_requests COMMAND meshvale_gltf_file_verified_provider_requests_tests)
    set_tests_properties(gltf_file_verified_provider_requests PROPERTIES TIMEOUT 360 RUN_SERIAL TRUE)
  else()
    add_test(NAME unsupported_gltf_file_publication_dependency
      COMMAND meshvale_gltf_file_publish_tests --unsupported-profile)
    add_test(NAME unsupported_gltf_file_verified_provider_dependency
      COMMAND meshvale_gltf_file_verified_provider_tests --unsupported-profile)
  endif()
endfunction()
