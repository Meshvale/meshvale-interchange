# Private Interchange source-identity resolver. No caller release override.
include_guard(GLOBAL)

function(_meshvale_interchange_normalize_name VALUE OUT)
  string(TOLOWER "${VALUE}" value)
  string(REGEX REPLACE "[-_.]+" "-" value "${value}")
  set(${OUT} "${value}" PARENT_SCOPE)
endfunction()

function(_meshvale_interchange_lines VALUE OUT)
  string(REPLACE ";" "\\;" value "${VALUE}")
  string(REPLACE "\r\n" "\n" value "${value}")
  string(REPLACE "\n" ";" value "${value}")
  set(${OUT} "${value}" PARENT_SCOPE)
endfunction()

function(_meshvale_interchange_stable VALUE OUT)
  set(result "")
  if("${VALUE}" MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    set(parts "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3}")
    set(result "")
    foreach(part IN LISTS parts)
      string(REGEX REPLACE "^0+" "" part "${part}")
      if(part STREQUAL "")
        set(part "0")
      endif()
      list(APPEND result "${part}")
    endforeach()
    list(JOIN result "." result)
  endif()
  set(${OUT} "${result}" PARENT_SCOPE)
endfunction()

function(_meshvale_interchange_version VALUE OUT_KIND OUT_VERSION)
  string(TOLOWER "${VALUE}" lower)
  _meshvale_interchange_stable("${VALUE}" stable)
  if(NOT stable STREQUAL "")
    set(kind stable)
    if(stable STREQUAL "0.0.0")
      set(kind zero)
    endif()
    set(version "${stable}")
  elseif(lower MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\.dev[0-9]+(\\+[a-z0-9]+([._-][a-z0-9]+)*)?$"
      OR lower MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\+[a-z0-9]+([._-][a-z0-9]+)*$")
    set(kind development)
    set(version "0.0.0")
  elseif(lower MATCHES "^[0-9]+!" OR lower MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+"
      OR lower MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+[.]?(a|b|rc|post)[0-9]+")
    message(FATAL_ERROR "Interchange source version: unsupported native version profile '${VALUE}'")
  else()
    message(FATAL_ERROR "Interchange source version: malformed version identity '${VALUE}'")
  endif()
  set(${OUT_KIND} "${kind}" PARENT_SCOPE)
  set(${OUT_VERSION} "${version}" PARENT_SCOPE)
endfunction()

function(_meshvale_interchange_tags VALUE OUT)
  _meshvale_interchange_lines("${VALUE}" tags)
  set(versions "")
  foreach(tag IN LISTS tags)
    if(tag MATCHES "^v(.*)$")
      _meshvale_interchange_stable("${CMAKE_MATCH_1}" stable)
      if(NOT stable STREQUAL "")
        list(APPEND versions "${stable}")
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES versions)
  list(LENGTH versions count)
  if(count GREATER 1)
    message(FATAL_ERROR "Interchange source version: ambiguous exact stable tags '${versions}'")
  endif()
  set(${OUT} "${versions}" PARENT_SCOPE)
endfunction()

function(_meshvale_interchange_archive PATH OUT_STATE OUT_VERSION)
  file(READ "${PATH}" text)
  _meshvale_interchange_lines("${text}" lines)
  set(fields "")
  foreach(line IN LISTS lines)
    if(line STREQUAL "")
      continue()
    endif()
    if(NOT line MATCHES "^([a-z-]+):[ \t]*(.*)$")
      message(FATAL_ERROR "Interchange source version: malformed archival field")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    string(REGEX REPLACE "[ \t]+$" "" value "${value}")
    if(NOT key MATCHES "^(meshvale-project|node|node-date|describe-name|ref-names)$" OR key IN_LIST fields)
      message(FATAL_ERROR "Interchange source version: unknown or duplicate archival field '${key}'")
    endif()
    list(APPEND fields "${key}")
    set(field_${key} "${value}")
  endforeach()
  list(LENGTH fields count)
  if(NOT count EQUAL 5 OR NOT field_meshvale-project STREQUAL "meshvale-interchange")
    message(FATAL_ERROR "Interchange source version: missing or wrong-product archival identity")
  endif()
  set(template_node [=[$Format:%H$]=])
  set(template_node-date [=[$Format:%cI$]=])
  set(template_describe-name [=[$Format:%(describe:tags=true,match=v[0-9]*)$]=])
  set(template_ref-names [=[$Format:%D$]=])
  set(unexpanded 0)
  foreach(key IN ITEMS node node-date describe-name ref-names)
    if("${field_${key}}" STREQUAL "${template_${key}}")
      math(EXPR unexpanded "${unexpanded} + 1")
    endif()
  endforeach()
  if(unexpanded EQUAL 4)
    set(${OUT_STATE} neutral PARENT_SCOPE)
    set(${OUT_VERSION} "0.0.0" PARENT_SCOPE)
    return()
  elseif(NOT unexpanded EQUAL 0)
    message(FATAL_ERROR "Interchange source version: partially expanded archival template")
  endif()
  foreach(key IN ITEMS node node-date describe-name ref-names)
    string(FIND "${field_${key}}" "$Format:" placeholder)
    if(NOT placeholder EQUAL -1)
      message(FATAL_ERROR "Interchange source version: residual archival format expression")
    endif()
  endforeach()
  string(LENGTH "${field_node}" node_length)
  if(NOT field_node MATCHES "^[0-9a-fA-F]+$" OR NOT (node_length EQUAL 40 OR node_length EQUAL 64))
    message(FATAL_ERROR "Interchange source version: malformed archival node")
  endif()
  if(NOT field_node-date MATCHES "^[0-9][0-9][0-9][0-9]-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-6][0-9](Z|[+-][0-2][0-9]:[0-5][0-9])$")
    message(FATAL_ERROR "Interchange source version: malformed archival node-date")
  endif()
  string(REPLACE ";" "\\;" refs "${field_ref-names}")
  string(REPLACE ", " ";" refs "${refs}")
  set(tags "")
  foreach(ref IN LISTS refs)
    string(REGEX REPLACE "^[ \t]+" "" ref "${ref}")
    string(REGEX REPLACE "[ \t]+$" "" ref "${ref}")
    if(ref MATCHES "^tag: (.+)$")
      string(APPEND tags "${CMAKE_MATCH_1}\n")
    endif()
  endforeach()
  _meshvale_interchange_tags("${tags}" stable)
  set(describe_stable "")
  set(nonexact FALSE)
  _meshvale_interchange_lines("${tags}" exact_tags)
  if("${field_describe-name}" IN_LIST exact_tags)
    if(field_describe-name MATCHES "^v(.*)$")
      _meshvale_interchange_stable("${CMAKE_MATCH_1}" describe_stable)
    endif()
  elseif(field_describe-name MATCHES "^(.+)-([0-9]+)-g([0-9a-fA-F]+)$")
    set(nonexact TRUE)
    set(short_node "${CMAKE_MATCH_3}")
    string(TOLOWER "${short_node}" short_node)
    string(TOLOWER "${field_node}" node)
    string(FIND "${node}" "${short_node}" position)
    if(NOT position EQUAL 0)
      message(FATAL_ERROR "Interchange source version: contradictory archival node/describe")
    endif()
  elseif(field_describe-name MATCHES "^v(.*)$")
    _meshvale_interchange_stable("${CMAKE_MATCH_1}" describe_stable)
  elseif(NOT field_describe-name STREQUAL "")
    message(FATAL_ERROR "Interchange source version: malformed archival describe")
  endif()
  if(NOT describe_stable STREQUAL "" AND NOT describe_stable STREQUAL stable)
    message(FATAL_ERROR "Interchange source version: contradictory exact archival tags")
  endif()
  if(nonexact AND NOT stable STREQUAL "")
    message(FATAL_ERROR "Interchange source version: nonexact describe conflicts with exact stable refs")
  endif()
  if(NOT stable STREQUAL "")
    set(state release)
    set(version "${stable}")
  else()
    set(state development)
    set(version "0.0.0")
  endif()
  set(${OUT_STATE} "${state}" PARENT_SCOPE)
  set(${OUT_VERSION} "${version}" PARENT_SCOPE)
endfunction()

function(_meshvale_interchange_pkg_info PATH OUT_KIND OUT_VERSION)
  file(READ "${PATH}" text)
  _meshvale_interchange_lines("${text}" lines)
  set(name_seen FALSE)
  set(version_seen FALSE)
  set(identity_previous FALSE)
  foreach(line IN LISTS lines)
    if(line STREQUAL "")
      break()
    endif()
    if(line MATCHES "^[ \t]")
      if(identity_previous)
        message(FATAL_ERROR "Interchange source version: folded identity header")
      endif()
      continue()
    endif()
    set(identity_previous FALSE)
    if(line MATCHES "^([^:]+):(.*)$")
      string(TOLOWER "${CMAKE_MATCH_1}" key)
      set(value "${CMAKE_MATCH_2}")
      string(REGEX REPLACE "^[ \t]+" "" value "${value}")
      string(REGEX REPLACE "[ \t]+$" "" value "${value}")
      if(key STREQUAL "name")
        if(name_seen)
          message(FATAL_ERROR "Interchange source version: duplicate Name header")
        endif()
        set(name_seen TRUE)
        set(identity_previous TRUE)
        _meshvale_interchange_normalize_name("${value}" name)
      elseif(key STREQUAL "version")
        if(version_seen)
          message(FATAL_ERROR "Interchange source version: duplicate Version header")
        endif()
        set(version_seen TRUE)
        set(identity_previous TRUE)
        set(version "${value}")
      endif()
    endif()
  endforeach()
  if(NOT name_seen OR NOT version_seen OR NOT name STREQUAL "meshvale-interchange")
    message(FATAL_ERROR "Interchange source version: missing or wrong-product PKG-INFO identity")
  endif()
  _meshvale_interchange_version("${version}" kind version)
  set(${OUT_KIND} "${kind}" PARENT_SCOPE)
  set(${OUT_VERSION} "${version}" PARENT_SCOPE)
endfunction()

function(meshvale_interchange_resolve_source_version OUT_VERSION OUT_PROVENANCE SOURCE_ROOT)
  if(NOT IS_DIRECTORY "${SOURCE_ROOT}")
    message(FATAL_ERROR "Interchange source version: source root is not a directory")
  endif()
  file(REAL_PATH "${SOURCE_ROOT}" root)
  set(version "0.0.0")
  set(provenance unversioned-development)
  set(release FALSE)
  set(own_git FALSE)
  set(Git_FOUND FALSE)
  if(NOT CMAKE_DISABLE_FIND_PACKAGE_Git)
    find_package(Git QUIET)
  endif()
  if(Git_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse --show-toplevel
      RESULT_VARIABLE git_result OUTPUT_VARIABLE git_root ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(git_result EQUAL 0)
      file(REAL_PATH "${git_root}" git_root)
      if(git_root STREQUAL root)
        set(own_git TRUE)
        set(provenance git-unverified-development)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" status --porcelain=v1 --untracked-files=all
          RESULT_VARIABLE status_result OUTPUT_VARIABLE status ERROR_QUIET)
        if(status_result EQUAL 0)
          set(provenance git-development)
          if(status STREQUAL "")
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" tag --points-at HEAD
              RESULT_VARIABLE tags_result OUTPUT_VARIABLE tags ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(tags_result EQUAL 0)
              _meshvale_interchange_tags("${tags}" stable)
              if(NOT stable STREQUAL "")
                set(version "${stable}")
                set(provenance git-release)
                set(release TRUE)
              endif()
            else()
              set(provenance git-unverified-development)
            endif()
          endif()
        endif()
      endif()
    endif()
  endif()
  if(NOT own_git AND EXISTS "${root}/.git")
    set(own_git TRUE)
    set(provenance git-unverified-development)
  endif()
  if(NOT own_git)
    set(archive_state neutral)
    if(EXISTS "${root}/.git_archival.txt")
      _meshvale_interchange_archive("${root}/.git_archival.txt" archive_state archive_version)
      if(archive_state STREQUAL "release")
        set(version "${archive_version}")
        set(release TRUE)
        set(provenance archive-release)
      elseif(archive_state STREQUAL "development")
        set(provenance archive-development)
      endif()
    endif()
    if(EXISTS "${root}/PKG-INFO")
      _meshvale_interchange_pkg_info("${root}/PKG-INFO" package_kind package_version)
      if(release)
        if(package_kind STREQUAL "development" OR NOT package_version STREQUAL version)
          message(FATAL_ERROR "Interchange source version: conflicting archive/PKG-INFO identities")
        endif()
      elseif(package_kind STREQUAL "stable")
        if(archive_state STREQUAL "development")
          message(FATAL_ERROR "Interchange source version: development archive conflicts with release PKG-INFO")
        endif()
        set(version "${package_version}")
        set(release TRUE)
        set(provenance sdist-release)
      elseif(archive_state STREQUAL "neutral")
        set(provenance sdist-development)
      endif()
    endif()
  endif()
  if(DEFINED SKBUILD_PROJECT_NAME)
    _meshvale_interchange_normalize_name("${SKBUILD_PROJECT_NAME}" backend_name)
    if(backend_name STREQUAL "meshvale-interchange")
      if(NOT DEFINED SKBUILD_PROJECT_VERSION_FULL)
        message(FATAL_ERROR "Interchange source version: matching backend requires SKBUILD_PROJECT_VERSION_FULL")
      endif()
      _meshvale_interchange_version("${SKBUILD_PROJECT_VERSION_FULL}" backend_kind backend_version)
      if(release)
        if(backend_kind STREQUAL "development" OR NOT backend_version STREQUAL version)
          message(FATAL_ERROR "Interchange source version: backend FULL conflicts with release provenance")
        endif()
      elseif(backend_kind STREQUAL "stable")
        message(FATAL_ERROR "Interchange source version: backend FULL is not release provenance")
      endif()
    endif()
  endif()
  set(${OUT_VERSION} "${version}" PARENT_SCOPE)
  set(${OUT_PROVENANCE} "${provenance}" PARENT_SCOPE)
endfunction()
