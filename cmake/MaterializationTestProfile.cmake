# Select the expected outcome; actual tests must prove the producer's behavior.
set(_MESHVALE_INTERCHANGE_PROFILE_QUALIFIED "qualified")
set(_MESHVALE_INTERCHANGE_PROFILE_UNSUPPORTED "unsupported")
set(_MESHVALE_INTERCHANGE_QUALIFIED_CLANG_VERSION "18.1.3")
set(_MESHVALE_INTERCHANGE_X64_POINTER_BYTES 8)
set(meshvale_materialization_default "${_MESHVALE_INTERCHANGE_PROFILE_UNSUPPORTED}")
if((MSVC AND WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL "${_MESHVALE_INTERCHANGE_X64_POINTER_BYTES}") OR
    (CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND
     CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "${_MESHVALE_INTERCHANGE_QUALIFIED_CLANG_VERSION}" AND
     CMAKE_BUILD_TYPE STREQUAL "Debug" AND CMAKE_SYSTEM_NAME STREQUAL "Linux"))
  set(meshvale_materialization_default "${_MESHVALE_INTERCHANGE_PROFILE_QUALIFIED}")
endif()
set(MESHVALE_INTERCHANGE_MATERIALIZATION_TEST_PROFILE "${meshvale_materialization_default}"
  CACHE STRING "Expected Geometry materialization runtime outcome: qualified or unsupported")
set_property(CACHE MESHVALE_INTERCHANGE_MATERIALIZATION_TEST_PROFILE PROPERTY STRINGS
  "${_MESHVALE_INTERCHANGE_PROFILE_QUALIFIED}" "${_MESHVALE_INTERCHANGE_PROFILE_UNSUPPORTED}")
if(NOT MESHVALE_INTERCHANGE_MATERIALIZATION_TEST_PROFILE STREQUAL "${_MESHVALE_INTERCHANGE_PROFILE_QUALIFIED}" AND
    NOT MESHVALE_INTERCHANGE_MATERIALIZATION_TEST_PROFILE STREQUAL "${_MESHVALE_INTERCHANGE_PROFILE_UNSUPPORTED}")
  message(FATAL_ERROR "Materialization test profile must be qualified or unsupported")
endif()
